diff --git a/dv/memory_tx/qualification.py b/dv/memory_tx/qualification.py
new file mode 100644
index 0000000..d67f2a0
--- /dev/null
+++ b/dv/memory_tx/qualification.py
@@ -0,0 +1,190 @@
+"""Model qualification and labeled trace fault checks, independent of RTL."""
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+from oracle import Oracle, Profile, Violation, require
+from traces import legal_trace, reset_traces, atomic_overlap_trace
+from ledger import Ledger
+from sweep import sweep
+from hand_checks import qualify_hand, metamorphic
+
+
+def replay(samples, profile, required=(), disabled=(), finish=True):
+    oracle=Oracle(profile,disabled)
+    ledger=Ledger(profile)
+    for sample in samples:
+        oracle.step(sample)
+        if not disabled:ledger.observe(sample,oracle)
+    return oracle.finish(required) if finish else oracle
+
+
+def qualify(profile, seed):
+    samples=legal_trace(profile,seed)
+    required=['exact_full','full_stall','full_arrival','full_exchange','atomic_commit',
+              'cell_final_hold','packet_final_hold','link_query','complete']+[f'keep_{i}' for i in range(1,9)]
+    report=replay(samples,profile,required)
+    report['trace_sha256']=hashlib.sha256(json.dumps(samples,sort_keys=True).encode()).hexdigest()
+    resets={name:replay(trace,profile,['reset','complete']) for name,trace in reset_traces(profile,seed).items()}
+    report['hand_witnesses']=qualify_hand(replay)
+    report['bounded_sweep']=sweep(profile,replay,seed)
+    report['metamorphic']=metamorphic(samples,profile,replay)
+    report['reset_phases']=resets
+    report['atomic_overlap']=replay(atomic_overlap_trace(profile,seed),profile,['atomic_store_retire'])
+    negatives={}
+    def negative(name, detector, mutate, *, finish=False):
+        trace=deepcopy(samples); end=mutate(trace)
+        trace=trace if end is None else trace[:end+1]
+        try: replay(trace,profile,finish=finish)
+        except Violation as error:
+            require(error.detector==detector,'selftest_wrong_detector',f'{name}: {error}')
+        else: raise AssertionError('selftest_missing_detection: '+name)
+        # Removal must be killed by this self-test, before a later unrelated alarm.
+        if end is not None:
+            try: replay(trace,profile,disabled=[detector],finish=False)
+            except Violation as error:raise AssertionError('selftest_removal_wrong_alarm: '+name+': '+str(error)) from error
+            negatives[name]={'detector':detector,'detector_removal':'KILLED_BY_'+name}
+        else: negatives[name]={'detector':detector}
+    def edit_first(predicate, change):
+        def mutate(trace):
+            for i,s in enumerate(trace):
+                if predicate(s): change(s);return i
+            raise AssertionError('missing fault trigger')
+        return mutate
+    has=lambda key:lambda s:key in s['actions']
+    action=lambda key:lambda s:s['actions'].pop(key)
+    for key,detector in [('info','metadata_info'),('commit_info','metadata_commit'),('dispatch_info','metadata_dispatch')]:
+        negative('wrong_'+key,detector,edit_first(has(key),lambda s,k=key:s['actions'][k].update(tag=s['actions'][k]['tag']^1)))
+    negative('missing_info_write','metadata_info_presence',edit_first(has('info'),action('info')))
+    negative('missing_response','response_presence',edit_first(has('response'),action('response')))
+    negative('wrong_response','response_data',edit_first(has('response'),lambda s:s['actions']['response'].update(data=s['actions']['response']['data']^1)))
+    negative('extra_response','response_presence',edit_first(lambda s:not s['reset'] and s['cycle']>3 and not s['actions'],lambda s:s['actions'].update(response={'data':0})))
+    for key,detector in [('keep','output_keep'),('last','output_last'),('user','output_user'),('data','output_data')]:
+        def mutate_output(trace,key=key):
+            for i,s in enumerate(trace):
+                if s['out']['valid'] and s['out']['ready'] and not (trace[i-1]['out']['valid'] and not trace[i-1]['out']['ready']):
+                    s['out'][key]^=1;return i
+            raise AssertionError('no unheld transfer')
+        negative('wrong_output_'+key,detector,mutate_output)
+    negative('missing_cell_return','cell_completion_presence',edit_first(has('free'),action('free')))
+    negative('wrong_cell_return','cell_completion_id',edit_first(has('free'),lambda s:s['actions'].update(free=(s['actions']['free']+1)%profile.cells)))
+    negative('missing_done','descriptor_completion_presence',edit_first(has('done'),action('done')))
+    negative('wrong_done','descriptor_completion_id',edit_first(has('done'),lambda s:s['actions'].update(done=1)))
+    negative('duplicate_done','descriptor_completion_presence',edit_first(lambda s:not s['reset'] and s['cycle']>3 and not s['actions'],lambda s:s['actions'].update(done=0)))
+    negative('duplicate_free','cell_completion_presence',edit_first(lambda s:not s['reset'] and s['cycle']>3 and not s['actions'],lambda s:s['actions'].update(free=0)))
+    negative('wrong_link','metadata_next',edit_first(has('query'),lambda s:s['actions']['query'].update(next=(s['actions']['query']['next']+1)%profile.cells)))
+    # Held fields corrupt on a successor to a genuine held-valid sample.
+    def late_response(trace):
+        for i,s in enumerate(trace):
+            if 'response' in s['actions']:
+                response=s['actions'].pop('response');trace[i+1]['actions']['response']=response;return i
+        raise AssertionError('no response')
+    negative('late_response','response_presence',late_response)
+    negative('duplicate_response','response_presence',edit_first(lambda s:not s['reset'] and s['cycle']>3 and not s['actions'],lambda s:s['actions'].update(response={'data':0})))
+    negative('early_cell_return','cell_completion_presence',edit_first(lambda s:s['out']['valid'] and not s['out']['ready'],lambda s:s['actions'].update(free=0)))
+    def omit_queries(trace):
+        for i,s in enumerate(trace):
+            s['actions'].pop('query',None)
+            if 'free' in s['actions'] and 'done' not in s['actions']:return i
+        raise AssertionError('no interior cell retirement')
+    negative('missing_link_capture','link_capture',omit_queries)
+    def overissue(trace):
+        occupied=0
+        for i,s in enumerate(trace):
+            if s['reset']:occupied=0;continue
+            transfer=s['out']['valid'] and s['out']['ready']
+            if occupied==profile.depth and not transfer:
+                for later in trace[i+1:]:
+                    if 'done' in later['actions']:break
+                    if 'read' in later['actions']:
+                        s['actions']['read']=later['actions']['read'];return i
+            occupied+=int('read' in s['actions'])-int(transfer)
+        raise AssertionError('no exact-capacity trigger')
+    negative('overissue','read_credit',overissue)
+    for key in ('valid','data','keep','last','user'):
+        def mutate(trace,key=key):
+            for i in range(1,len(trace)):
+                prev=trace[i-1]['out']
+                if prev['valid'] and not prev['ready']:
+                    trace[i]['out'][key]^=1;return i
+            raise AssertionError('no hold')
+        # Other semantic checks would also reject the corruption after removing hold.
+        trace=deepcopy(samples);end=mutate(trace)
+        try:replay(trace[:end+1],profile,finish=False)
+        except Violation as error:require(error.detector=='held_output','selftest_wrong_detector',str(error))
+        else:raise AssertionError('missing held detector')
+        negatives['held_'+key]={'detector':'held_output'}
+    # Missing final transaction cannot quietly pass shutdown.
+    end=next(i for i,s in enumerate(samples) if 'done' in s['actions'])
+    for name,trace,detector in [('missing_final_output',samples[:end],'shutdown_ownership'),
+                               ('missing_completion_leak',samples[:end],'shutdown_ownership')]:
+        try:replay(trace,profile)
+        except Violation as error:require(error.detector==detector,'selftest_wrong_detector',str(error))
+        else:raise AssertionError(name)
+        negatives[name]={'detector':detector}
+    # Direct equations are separate arithmetic witnesses, not model-state edits.
+    equations=[]
+    for depth in (4,8):
+        for B in range(depth+1):
+            for O in range(3):
+                for R in (0,1):
+                    for I in (0,1):
+                        for T in (0,1):
+                            if B+O>depth or R>O or T>B:continue
+                            post_B=B+R-T;post_O=O+I-R
+                            legal=B+O+I-T<=depth
+                            require((post_B+post_O<=depth)==legal,'equation_witness')
+                            require((post_B+post_O+1<=depth)!=legal or I==0 or T==0 or B+O!=depth,
+                                    'wrong_delta_witness')
+                            equations.append([depth,B,O,R,I,T,post_B,post_O,legal])
+    # Environment rejection is separate from a DUT guarantee detector.
+    environment={}
+    for name,field,value,detector in [('latency','latency',3,'parameter_latency'),('depth','depth',2,'parameter_depth'),
+                                      ('cell','cell_bytes',8,'parameter_cell'),('length','max_length',1537,'parameter_length')]:
+        from dataclasses import asdict
+        values=asdict(profile);values[field]=value
+        try:Profile(**values)
+        except Violation as error:require(error.detector==detector,'environment_wrong_detector')
+        else:raise AssertionError('unsupported configuration passed')
+        environment[name]=detector
+    trace=deepcopy(atomic_overlap_trace(profile,seed))
+    overlap=next(i for i,s in enumerate(trace) if 'done' in s['actions'] and 'reserve' in s['actions'])
+    # Reusing the just-returned cell on the same edge is illegal even though a return occurs.
+    trace[overlap]['actions']['allocate']['cell']=trace[overlap]['actions']['free']
+    try:replay(trace[:overlap+1],profile,finish=False)
+    except Violation as error:require(error.detector=='environment_cell_reuse','environment_wrong_detector',str(error))
+    else:raise AssertionError('same-edge reuse accepted')
+    environment['same_edge_return_reuse']='environment_cell_reuse'
+    for name,edit,detector in [('missing_sample',lambda t:t.pop(5),'sample_cycle'),
+                               ('duplicate_sample',lambda t:t.insert(5,deepcopy(t[4])),'sample_cycle'),
+                               ('mixed_epoch',lambda t:t[5].update(epoch=t[5]['epoch']+1),'sample_epoch')]:
+        trace=deepcopy(samples);edit(trace)
+        try:replay(trace,profile)
+        except Violation as error:require(error.detector==detector,'sample_wrong_detector',str(error))
+        else:raise AssertionError(name)
+        negatives[name]={'detector':detector}
+    try:replay(samples,profile,['absent_required_trigger'])
+    except Violation as error:require(error.detector=='required_bin','required_bin_wrong_detector')
+    else:raise AssertionError('unhit required bin passed')
+    negatives['absent_required_trigger']={'detector':'required_bin'}
+    report.update(negatives=negatives,environment_rejections=environment,equation_combinations=len(equations))
+    return report,samples
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--seed',type=int,default=17)
+    parser.add_argument('--profile-json',type=Path,required=True)
+    parser.add_argument('--output',type=Path,required=True)
+    args=parser.parse_args()
+    profile=Profile(**json.loads(args.profile_json.read_text()))
+    report,samples=qualify(profile,args.seed)
+    args.output.mkdir(parents=True,exist_ok=True)
+    (args.output/'qualification.json').write_text(json.dumps(report,indent=2)+'\n')
+    (args.output/'samples.jsonl').write_text(''.join(json.dumps(s)+'\n' for s in samples))
+    print('TM_MEMORY_TX_ORACLE_PASS '+report['trace_sha256'])
+
+if __name__=='__main__':main()
diff --git a/dv/memory_tx/replay.sv b/dv/memory_tx/replay.sv
new file mode 100644
index 0000000..627aff1
--- /dev/null
+++ b/dv/memory_tx/replay.sv
@@ -0,0 +1,258 @@
+`timescale 1ns/1ps
+package memory_tx_wires;
+    `include "wires.svh"
+endpackage
+
+interface memory_tx_replay_if(input logic clk);
+    import memory_tx_wires::*;
+    logic capture, rst_n;
+    memory_actions_t actions;
+endinterface
+
+package memory_tx_replay_pkg;
+    import uvm_pkg::*;
+    import tm_bench_types::*;
+    import tm_bench_pkg::*;
+    import memory_tx_wires::*;
+    `include "uvm_macros.svh"
+
+    class memory_action_sample extends tm_sample;
+        memory_actions_t actions;
+        function new(string name="action_sample");super.new(name);endfunction
+    endclass
+
+    class memory_action_monitor extends uvm_monitor;
+        `uvm_component_utils(memory_action_monitor)
+        virtual memory_tx_replay_if vif;
+        uvm_analysis_port #(tm_sample) observed;
+        tm_stamp stamp;
+        bit injected;
+        function new(string name,uvm_component parent);
+            super.new(name,parent);observed=new("observed",this);stamp=new;
+        endfunction
+        task run_phase(uvm_phase phase);
+            memory_action_sample sample;
+            forever begin
+                @(posedge vif.clk);
+                sample=new;sample.source=N_RX+3;sample.actions=vif.actions;
+                stamp.apply(sample,!vif.rst_n);
+                if(vif.capture && !injected && $test$plusargs("MIXED_SAMPLE"))sample.batch.cycle++;
+                observed.write(sample);
+                if(vif.capture && !injected && $test$plusargs("DUPLICATE_SAMPLE"))observed.write(sample);
+                if(vif.capture)injected=1;
+            end
+        endtask
+    endclass
+
+    class memory_replay_collector extends uvm_component;
+        `uvm_component_utils(memory_replay_collector)
+        uvm_analysis_imp #(tm_sample,memory_replay_collector) samples;
+        virtual memory_tx_replay_if vif;
+        bit [1:0] seen;
+        int epoch,cycle,reset,edges,reads,responses,outputs,returns,completions,stalls;
+        int live_reads,buffered;
+        int due_cycles[$];
+        logic [63:0] due_data[$];
+        logic [63:0] memory_image[int];
+        int file;
+        monitor_batch_t pending;
+        memory_actions_t actions;
+        bit have_last;
+        int last_epoch;
+        longint unsigned last_cycle;
+        covergroup observed_traffic with function sample(bit read_v,bit response_v,bit transfer,bit held,bit release_cell,bit complete);
+            option.per_instance=1;
+            issue:coverpoint read_v;
+            response:coverpoint response_v;
+            output_transfer:coverpoint transfer;
+            output_hold:coverpoint held;
+            cell_return:coverpoint release_cell;
+            descriptor_done:coverpoint complete;
+            overlap:cross response,output_transfer,issue;
+        endgroup
+        function new(string name,uvm_component parent);
+            super.new(name,parent);samples=new("samples",this);observed_traffic=new;
+        endfunction
+        function void build_phase(uvm_phase phase);file=$fopen("observed.jsonl","w");endfunction
+        function void write(tm_sample sample);
+            memory_action_sample action_sample;
+            int lane;
+            bit transfer;
+            if(!vif.capture)return;
+            lane=(sample.source==N_RX)?0:1;
+            if(sample.source!=N_RX && sample.source!=N_RX+3) `uvm_fatal("MEMORY_SAMPLE_SOURCE","unknown monitor source")
+            if($test$plusargs("OMIT_ACTION") && lane==1)return;
+            if($test$plusargs("OMIT_FINAL_ACTION") && lane==1 && vif.actions.done_v!=0)return;
+            if(seen=='0)begin
+                pending='0;pending.epoch=sample.batch.epoch;pending.cycle=sample.batch.cycle;
+                pending.reset_asserted=sample.batch.reset_asserted;
+                if(have_last && (sample.batch.epoch<last_epoch || (sample.batch.epoch==last_epoch && sample.batch.cycle<=last_cycle)))
+                    `uvm_fatal("MEMORY_SAMPLE_STALE","stale sample")
+            end
+            if(sample.batch.epoch!=pending.epoch || sample.batch.cycle!=pending.cycle || sample.batch.reset_asserted!=pending.reset_asserted)
+                `uvm_fatal("MEMORY_SAMPLE_MIXED","incomplete or mixed-cycle sample")
+            if(seen[lane]) `uvm_fatal("MEMORY_SAMPLE_DUPLICATE","duplicate sample")
+            seen[lane]=1;
+            if(lane==0)pending.output_sample=sample.batch.output_sample;
+            else begin
+                if(!$cast(action_sample,sample)) `uvm_fatal("MEMORY_SAMPLE_TYPE","missing action record")
+                actions=action_sample.actions;
+            end
+            if(&seen)begin
+                $fdisplay(file,"{\"epoch\":%0d,\"cycle\":%0d,\"reset\":%0d,\"actions\":\"%h\",\"valid\":%0d,\"ready\":%0d,\"data\":\"%h\",\"keep\":\"%h\",\"last\":%0d,\"user\":\"%h\"}",pending.epoch,edges,pending.reset_asserted,actions,pending.output_sample.valid,pending.output_sample.ready,pending.output_sample.beat.data,pending.output_sample.beat.keep,pending.output_sample.beat.last,pending.output_sample.beat.user);
+                $fflush(file);                if((actions.response_v!=0)!=(due_cycles.size()>0 && due_cycles[0]==edges))
+                    `uvm_fatal("MEMORY_RESPONSE_PRESENCE","fixed-latency response missing or extra")
+                if(actions.response_v!=0)begin
+                    if(actions.response_data!=due_data[0]) `uvm_fatal("MEMORY_RESPONSE_DATA","response differs from sampled write image")
+                    void'(due_cycles.pop_front());void'(due_data.pop_front());
+                end
+                if(actions.read_v!=0)begin
+                    if(!memory_image.exists(int'(actions.read_addr))) `uvm_fatal("MEMORY_READ_UNWRITTEN","read before sampled write")
+                    due_cycles.push_back(edges+MEM_RD_LATENCY);due_data.push_back(memory_image[int'(actions.read_addr)]);
+                end
+                if(actions.write_v!=0)begin
+                    if(actions.read_v!=0 && actions.read_addr==actions.write_addr) `uvm_fatal("MEMORY_COLLISION","same-word read/write")
+                    memory_image[int'(actions.write_addr)]=actions.write_data;
+                end
+                transfer=pending.output_sample.valid && pending.output_sample.ready;
+                if(pending.reset_asserted)begin live_reads=0;buffered=0;end
+                else begin
+                    if(actions.read_v!=0)begin live_reads++;reads++;end
+                    // Old physical responses during reset are sampled but give no live credit.
+                    if(actions.response_v!=0 && live_reads>0)begin live_reads--;buffered++;responses++;end
+                    if(transfer)begin buffered--;outputs++;end
+                    if(buffered<0 || live_reads<0 || buffered+live_reads>TX_FIFO_DEPTH)
+                        `uvm_fatal("MEMORY_CREDIT","sampled credit equation")
+                    if(actions.free_v!=0)returns++;
+                    if(actions.done_v!=0)completions++;
+                    if(pending.output_sample.valid && !pending.output_sample.ready)stalls++;
+                    observed_traffic.sample(actions.read_v!=0,actions.response_v!=0,transfer,
+                        pending.output_sample.valid&&!pending.output_sample.ready,actions.free_v!=0,actions.done_v!=0);
+                end
+edges++;seen='0;have_last=1;last_epoch=pending.epoch;last_cycle=pending.cycle;
+            end
+        endfunction
+        function void drained();
+            if(seen!='0) `uvm_fatal("MEMORY_SAMPLE_MISSING","incomplete final sample")
+            if(live_reads!=0 || buffered!=0) `uvm_fatal("MEMORY_SHUTDOWN","nonempty transactions")
+            if(reads==0 || responses==0 || outputs==0 || returns==0 || completions==0 || stalls==0)
+                `uvm_fatal("MEMORY_REQUIRED_TRIGGER","absent required trigger")
+            $display("TM_MEMORY_TX_BENCH_PASS edges=%0d reads=%0d responses=%0d outputs=%0d returns=%0d done=%0d holds=%0d",edges,reads,responses,outputs,returns,completions,stalls);
+        endfunction
+        function void final_phase(uvm_phase phase);$fclose(file);endfunction
+    endclass
+
+    class memory_replay_item extends uvm_sequence_item;
+        `uvm_object_utils(memory_replay_item)
+        bit reset;
+        memory_actions_t actions;
+        bit valid,ready;
+        beat_t beat;
+        function new(string name="memory_replay_item");super.new(name);endfunction
+    endclass
+
+    class memory_replay_sequence extends uvm_sequence #(memory_replay_item);
+        `uvm_object_utils(memory_replay_sequence)
+        function new(string name="memory_replay_sequence");super.new(name);endfunction
+        task body();
+            string path;
+            int input_file,got,reset_value,valid_value,ready_value,last_value,rows;
+            memory_actions_t values;
+            logic [63:0] data,user;
+            logic [7:0] keep;
+            memory_replay_item item;
+            if(!$value$plusargs("REPLAY=%s",path)) `uvm_fatal("REPLAY_INPUT","missing replay")
+            input_file=$fopen(path,"r");
+            if(input_file==0) `uvm_fatal("REPLAY_INPUT","cannot open replay")
+            while(!$feof(input_file))begin
+                got=$fscanf(input_file,"%d %h %d %d %h %h %d %h\n",reset_value,values,valid_value,ready_value,data,keep,last_value,user);
+                if(got!=8) `uvm_fatal("REPLAY_INPUT","malformed or empty row")
+                item=new;start_item(item);
+                item.reset=reset_value!=0;item.actions=values;
+                item.valid=valid_value!=0;item.ready=ready_value!=0;
+                item.beat='{data:data,keep:keep,last:last_value!=0,user:user};
+                finish_item(item);rows++;
+            end
+            if(rows==0) `uvm_fatal("REPLAY_INPUT","empty replay")
+            $fclose(input_file);
+        endtask
+    endclass
+
+    class memory_replay_driver extends uvm_driver #(memory_replay_item);
+        `uvm_component_utils(memory_replay_driver)
+        virtual memory_tx_replay_if vif;
+        virtual tm_stream_if stream;
+        function new(string name,uvm_component parent);super.new(name,parent);endfunction
+        task run_phase(uvm_phase phase);
+            memory_replay_item item;
+            forever begin
+                seq_item_port.get_next_item(item);
+                @(negedge vif.clk);vif.capture=1;vif.rst_n=!item.reset;vif.actions=item.actions;
+                stream.valid=item.valid;stream.ready=item.ready;stream.beat=item.beat;
+                @(posedge vif.clk);seq_item_port.item_done();
+            end
+        endtask
+    endclass
+
+    class memory_tx_replay_test extends uvm_test;
+        `uvm_component_utils(memory_tx_replay_test)
+        virtual memory_tx_replay_if vif;
+        virtual tm_stream_if stream;
+        tm_stream_agent output_agent;
+        memory_action_monitor action_monitor;
+        memory_replay_collector collector;
+        memory_replay_driver driver;
+        uvm_sequencer #(memory_replay_item) sequencer;
+        function new(string name,uvm_component parent);super.new(name,parent);endfunction
+        function void build_phase(uvm_phase phase);
+            if(!uvm_config_db#(virtual memory_tx_replay_if)::get(this,"","vif",vif)) `uvm_fatal("CONFIG","replay vif missing")
+            if(!uvm_config_db#(virtual tm_stream_if)::get(this,"","stream",stream)) `uvm_fatal("CONFIG","stream vif missing")
+            uvm_config_db#(virtual tm_stream_if)::set(this,"output_agent","vif",stream);
+            output_agent=tm_stream_agent::type_id::create("output_agent",this);
+            output_agent.is_active=UVM_PASSIVE;output_agent.source=N_RX;
+            action_monitor=memory_action_monitor::type_id::create("action_monitor",this);action_monitor.vif=vif;
+            collector=memory_replay_collector::type_id::create("collector",this);collector.vif=vif;
+            driver=memory_replay_driver::type_id::create("driver",this);driver.vif=vif;driver.stream=stream;
+            sequencer=new("sequencer",this);
+        endfunction
+        function void connect_phase(uvm_phase phase);
+            output_agent.monitor.observed.connect(collector.samples);
+            action_monitor.observed.connect(collector.samples);
+            driver.seq_item_port.connect(sequencer.seq_item_export);
+        endfunction
+        task run_phase(uvm_phase phase);
+            memory_replay_sequence stimulus;
+            phase.raise_objection(this);stimulus=new;
+            stimulus.start(sequencer);
+            @(negedge vif.clk);vif.capture=0;
+            collector.drained();phase.drop_objection(this);
+        endtask
+    endclass
+endpackage
+
