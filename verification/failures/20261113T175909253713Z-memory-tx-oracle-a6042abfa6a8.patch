diff --git a/dv/memory_tx/adapter.py b/dv/memory_tx/adapter.py
new file mode 100644
index 0000000..033c35d
--- /dev/null
+++ b/dv/memory_tx/adapter.py
@@ -0,0 +1,69 @@
+"""Public-action wire encoding for sealed monitor replay; no expected behavior."""
+from pathlib import Path
+import json
+
+FIELDS=[('reserve_v',32),('desc',32),('length',32),('qid',32),('tag',32),('source',32),
+        ('alloc_v',32),('alloc_cell',32),('alloc_desc',32),
+        ('write_v',32),('write_addr',32),('write_data',64),
+        ('info_v',32),('info_desc',32),('info_length',32),('info_qid',32),('info_tag',32),('info_source',32),('info_head',32),('info_ncell',32),
+        ('link_v',32),('link_cell',32),('link_next',32),('commit_v',32),('commit_desc',32),
+        ('dispatch_v',32),('dispatch_desc',32),('read_v',32),('read_addr',32),
+        ('response_v',32),('response_data',64),('query_v',32),('query_cell',32),('query_next',32),
+        ('free_v',32),('free_cell',32),('done_v',32),('done_desc',32)]+[(event+'_'+key,32) for event in ('commit_info','dispatch_info') for key in ('v','desc','length','qid','tag','source','head','ncell')]
+
+
+def encode_actions(actions):
+    values={name:0 for name,_ in FIELDS}
+    mapping={'reserve':{'desc':'desc','length':'length','qid':'qid','tag':'tag','source':'source'},
+             'allocate':{'cell':'alloc_cell','desc':'alloc_desc'},'write':{'addr':'write_addr','data':'write_data'},
+             'info':{key:'info_'+key for key in ('desc','length','qid','tag','source','head','ncell')},
+             'link':{'cell':'link_cell','next':'link_next'},'response':{'data':'response_data'},
+             'query':{'cell':'query_cell','next':'query_next'}}
+    for event in ('commit_info','dispatch_info'):
+        mapping[event]={key:event+'_'+key for key in ('desc','length','qid','tag','source','head','ncell')}
+    for action,fields in mapping.items():
+        if action not in actions:continue
+        values[{'allocate':'alloc'}.get(action,action)+'_v']=1
+        for key,target in fields.items():values[target]=actions[action][key]
+    for action,key in [('commit','desc'),('dispatch','desc'),('read','addr'),('free','cell'),('done','desc')]:
+        if action in actions:values[action+'_v']=1;values[action+'_'+key]=actions[action]
+    word=0
+    for name,width in FIELDS:word=(word<<width)|values[name]
+    return word
+
+
+def decode_actions(word):
+    values={}
+    for name,width in reversed(FIELDS):values[name]=word&((1<<width)-1);word>>=width
+    actions={}
+    for action,prefix,keys in [('reserve','',('desc','length','qid','tag','source')),('allocate','alloc_',('cell','desc')),
+                               ('write','write_',('addr','data')),('info','info_',('desc','length','qid','tag','source','head','ncell')),
+                               ('link','link_',('cell','next')),('response','response_',('data',)),('query','query_',('cell','next'))]:
+        if values[{'allocate':'alloc'}.get(action,action)+'_v']:
+            actions[action]={key:values[prefix+key] for key in keys}
+    for event in ('commit_info','dispatch_info'):
+        if values[event+'_v']:
+            actions[event]={key:values[event+'_'+key] for key in ('desc','length','qid','tag','source','head','ncell')}
+    for action,key in [('commit','desc'),('dispatch','desc'),('read','addr'),('free','cell'),('done','desc')]:
+        if values[action+'_v']:actions[action]=values[action+'_'+key]
+    return actions
+
+
+def write_replay(path,samples):
+    lines=[]
+    for s in samples:
+        o=s['out']
+        lines.append(f"{int(s['reset'])} {encode_actions(s['actions']):x} {int(o['valid'])} {int(o['ready'])} {o['data']:x} {o['keep']:x} {int(o['last'])} {o['user']:x}\n")
+    Path(path).write_text(''.join(lines))
+
+
+def read_observed(path):
+    result=[]
+    for line in Path(path).read_text().splitlines():
+        raw=json.loads(line)
+        result.append(dict(epoch=raw['epoch'],cycle=raw['cycle'],reset=bool(raw['reset']),
+                           actions=decode_actions(int(raw['actions'],16)),
+                           out=dict(valid=bool(raw['valid']),ready=bool(raw['ready']),
+                                    data=int(raw['data'],16),keep=int(raw['keep'],16),
+                                    last=bool(raw['last']),user=int(raw['user'],16))))
+    return result
diff --git a/dv/memory_tx/hand_checks.py b/dv/memory_tx/hand_checks.py
new file mode 100644
index 0000000..af2c426
--- /dev/null
+++ b/dv/memory_tx/hand_checks.py
@@ -0,0 +1,58 @@
+"""Literal byte/lifetime witnesses and contract-valid metamorphic checks."""
+from copy import deepcopy
+from oracle import Profile, require, Violation
+from traces import Trace, idle_output
+
+
+def hand_trace(profile):
+    # Literal C=16 fragmented chain; these values are independent of random stimulus.
+    require(profile.cell_bytes==16,'hand_profile')
+    t=Trace(profile);t.reset()
+    info=dict(desc=0,length=35,qid=0,tag=7,source=0)
+    addresses=[10,11,2,3,18]
+    data=[0x0706050403020100,0x0f0e0d0c0b0a0908,0x1716151413121110,0x1f1e1d1c1b1a1918,0xaaaaaaaabb222120]
+    for i,(addr,word) in enumerate(zip(addresses,data)):
+        a={'write':{'addr':addr,'data':word}}
+        if i==0:a.update(reserve=info,info=info|{'head':5,'ncell':3},allocate={'desc':0,'cell':5})
+        if i==2:a.update(allocate={'desc':0,'cell':1},link={'cell':5,'next':1})
+        if i==4:a.update(allocate={'desc':0,'cell':9},link={'cell':1,'next':9},commit=0)
+        t.edge(a)
+    packet=dict(info=info,chain=[5,1,9],raw=bytes(range(35)),words=list(zip(addresses,data)))
+    t.send(packet);t.drain()
+    return t.samples
+
+
+def qualify_hand(replay):
+    results=[]
+    for latency in (1,2):
+        for depth in (4,8):
+            p=Profile(latency=latency,depth=depth)
+            samples=hand_trace(p);report=replay(samples,p)
+            transfers=[s for s in samples if s['out']['valid'] and s['out']['ready']]
+            require([s['out']['keep'] for s in transfers]==[255,255,255,255,7],'hand_keeps')
+            require([s['actions'].get('free') for s in transfers]==[None,5,None,1,9],'hand_lifetimes')
+            require([s['actions'].get('done') for s in transfers]==[None,None,None,None,0],'hand_descriptor')
+            raw=bytes((s['out']['data']>>(lane*8))&255 for s in transfers for lane in range(8) if s['out']['keep']&(1<<lane))
+            require(raw==bytes(range(35)),'hand_bytes')
+            issued=[(s['cycle'],s['actions']['read']) for s in samples if 'read' in s['actions']]
+            arrived=[s['cycle'] for s in samples if 'response' in s['actions']]
+            require([address for _,address in issued]==[10,11,2,3,18],'hand_read_order')
+            require(arrived==[cycle+latency for cycle,_ in issued],'hand_latency')
+            results.append(dict(latency=latency,depth=depth,valid_bytes=len(raw),returns=[5,1,9]))
+    return results
+
+
+def metamorphic(samples,profile,replay):
+    renamed=deepcopy(samples)
+    for s in renamed:
+        for key in ('reserve','info','commit_info','dispatch_info'):
+            if key in s['actions']:s['actions'][key]['tag']^=0x2345
+        if s['out']['valid']:s['out']['user']^=0x2345<<24
+    replay(renamed,profile)
+    unused=deepcopy(samples)
+    for s in unused:
+        if s['out']['valid']:
+            for lane in range(8):
+                if not s['out']['keep']&(1<<lane):s['out']['data']^=0x5a<<(lane*8)
+    replay(unused,profile)
+    return {'tag_bijection':'PASS','unused_output_lanes':'PASS'}
diff --git a/dv/memory_tx/ledger.py b/dv/memory_tx/ledger.py
new file mode 100644
index 0000000..3b3dafb
--- /dev/null
+++ b/dv/memory_tx/ledger.py
@@ -0,0 +1,43 @@
+"""Recompute lifetime and read totals from sample history, independent of deltas."""
+from collections import Counter
+from oracle import require
+
+
+class Ledger:
+    def __init__(self,profile):
+        self.p=profile;self.epoch=-1;self.reservations=[];self.active=None
+        self.reads=[];self.outputs=0;self.responses=0
+
+    def observe(self,sample,model):
+        if sample['reset']:
+            self.reservations=[];self.active=None;self.reads=[];self.outputs=self.responses=0
+            return
+        a=sample['actions']
+        if 'reserve' in a:
+            self.reservations.append(dict(info=a['reserve'],allocations=0,beats=0,retirements=0,ended=False))
+        if 'allocate' in a:
+            lifetime=next(r for r in reversed(self.reservations) if r['info']['desc']==a['allocate']['desc'] and not r['ended'])
+            lifetime['allocations']+=1
+        if 'dispatch' in a:
+            self.active=next(r for r in reversed(self.reservations) if r['info']['desc']==a['dispatch'] and not r['ended'])
+        if 'read' in a:self.reads.append(sample['cycle']+self.p.latency)
+        self.responses=sum(due<=sample['cycle'] for due in self.reads)
+        if sample['out']['valid'] and sample['out']['ready']:
+            require(self.active is not None,'ledger_output_without_dispatch')
+            self.active['beats']+=1;self.outputs+=1
+            length=self.active['info']['length'];consumed=min(length,self.active['beats']*8)
+            # A cell retires only when all its bytes are externally consumed.
+            self.active['retirements']=consumed//self.p.cell_bytes+int(consumed==length and length%self.p.cell_bytes!=0)
+            if consumed==length:self.active['ended']=True;self.active=None
+        budget=sum((r['info']['length']+self.p.cell_bytes-1)//self.p.cell_bytes for r in self.reservations)
+        allocated=sum(r['allocations'] for r in self.reservations)
+        retired=sum(r['retirements'] for r in self.reservations)
+        expected_H=Counter()
+        for r in self.reservations:
+            expected_H[r['info']['qid']]+=(r['info']['length']+self.p.cell_bytes-1)//self.p.cell_bytes-r['retirements']
+        require((model.U,model.A,model.R)==(self.p.cells-budget+retired,allocated-retired,budget-allocated),
+                'ledger_resources')
+        require(model.H==expected_H,'ledger_queue_credit')
+        require(len(model.packets)==sum(not r['ended'] for r in self.reservations),'ledger_descriptors')
+        require(len(model.pending)==len(self.reads)-self.responses and len(model.buffered)==self.responses-self.outputs,
+                'ledger_transactions')
