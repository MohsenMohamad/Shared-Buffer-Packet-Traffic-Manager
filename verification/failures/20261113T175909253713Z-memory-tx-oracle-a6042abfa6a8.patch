+"""Preparation-only memory/TX modes; never resolve production source lists."""
+import json
+from pathlib import Path
+import sys
+from evidence import Case, ROOT, completed, output
+from registry import profile, sources, fingerprint
+
+
+def identity_paths():
+    return ['AGENTS.md','docs/spec','docs/implementation/tasks/P05-memory-tx.md',
+            'rtl/include','formal/tx','dv/memory_tx','dv/agents/tm_stream_agent.svh',
+            'dv/model/tm_monitor_types.svh','dv/env/tm_bench_pkg.sv',
+            'tools','verification/profiles.json','verification/suites.json',
+            'verification/sources/memory-tx-preparation.json']
+
+
+def parameters(args):
+    p=profile(args.profile)
+    return dict(latency=p['MEM_RD_LATENCY'],depth=p['TX_FIFO_DEPTH'],cell_bytes=p['CELL_BYTES'],
+                cells=p['N_CELL'],descriptors=p['N_DESC'],max_length=p['MAX_PACKET_BYTES'],
+                queues=p['N_Q'],sources=p['N_RX'])
+
+
+def memory_tx_oracle(run,args):
+    seed=(args.seed or [17])[0]
+    run.scope='Independent memory/TX preparation; production/performance/formal/DUT coverage NOT_RUN'
+    case=Case(run,'memory-tx-oracle',seed)
+    p=parameters(args);case.data.update(parameters=p,source_set='memory-tx-preparation')
+    config=case.path/'profile.json';config.write_text(json.dumps(p))
+    step=case.execute([sys.executable,ROOT/'dv/memory_tx/qualification.py',
+                       '--profile-json',config,'--seed',str(seed),'--output',case.path],timeout=args.timeout)
+    result,reason=completed(step,'TM_MEMORY_TX_ORACLE_PASS')
+    if result=='PASS':
+        case.data['qualification']=json.loads((case.path/'qualification.json').read_text())
+        case.data['artifacts'].update(samples=str(case.path/'samples.jsonl'),qualification=str(case.path/'qualification.json'))
+    case.finish(result,reason)
+    if result=='PASS' and args.profile=='E0' and seed==17:
+        parameter_probes(run,args)
+        model_mutations(run,args,config,seed)
+
+
+def memory_tx_bench(run,args):
+    from memory_tx_bench import bench
+    bench(run,args)
+
+
+def memory_tx_dut(run,args):
+    case=Case(run,'memory-tx-dut')
+    case.finish('NOT_IMPLEMENTED','Preparation has no authorized implementation source selection; no DUT executed',
+                scope='Future exact-source DUT adapter required; oracle/bench PASS cannot satisfy this mode')
+
+
+def parameter_probes(run,args):
+    """Both pinned frontends reject the public unsupported-configuration sentinel."""
+    from frontend import read_sources
+    source=ROOT/'dv/memory_tx/parameters.sv'
+    include=ROOT/'rtl/include'
+    for frontend in ('verilator','slang'):
+        case=Case(run,'memory-tx-parameters-'+frontend)
+        observations=[]
+        for name,params in [('valid',{}),('latency',{'MEM_RD_LATENCY':3}),
+                            ('depth',{'MEM_RD_LATENCY':2,'TX_FIFO_DEPTH':3}),
+                            ('cell',{'CELL_BYTES':8}),('length',{'MAX_PACKET_BYTES':1537}),
+                            ('width',{'CELL_COUNT_W':1})]:
+            if frontend=='verilator':
+                command=['verilator','--lint-only','--top-module','memory_tx_parameters','-I'+str(include),str(source)]
+                command += ['-G'+key+'='+str(value) for key,value in params.items()]
+            else:
+                script=case.path/(name+'.ys')
+                script.write_text(read_sources([source],'memory_tx_parameters',includes=[include],params=params)+'hierarchy -check -top memory_tx_parameters\n')
+                command=['yosys','-s',str(script)]
+            step=case.execute(command,timeout=args.timeout,stem=name)
+            valid=step['returncode']==0 if name=='valid' else step['result']!='TIMEOUT' and step['returncode'] not in (0,None) and 'TM_INVALID_CONFIGURATION' in output(step)
+            observations.append(dict(name=name,qualified=valid,expected='ACCEPT' if name=='valid' else 'PARAMETER_REJECTION'))
+        ok=all(row['qualified'] for row in observations)
+        case.finish('PASS' if ok else 'FAIL',None if ok else 'Public parameter acceptance/rejection did not qualify',observations=observations,
+                    source_set='public-parameter-probe',parameters='tm_parameters.svh defaults with named invalid overrides')
+
+
+def model_mutations(run,args,config,seed):
+    """Intentional model faults are isolated copies and must fail their own self-test."""
+    import shutil
+    import tempfile
+    targets={'response_presence':'missing_response','response_data':'wrong_response',
+             'output_data':'wrong_output_data','output_keep':'wrong_output_keep',
+             'cell_completion_presence':'missing_cell_return','descriptor_completion_presence':'missing_done',
+             'link_capture':'missing_link_capture','read_credit':'overissue'}
+    for detector,test in targets.items():
+        case=Case(run,'memory-tx-remove-'+detector,seed)
+        directory=case.path/'isolated-model';shutil.copytree(ROOT/'dv/memory_tx',directory,ignore=shutil.ignore_patterns('__pycache__'))
+        oracle=directory/'oracle.py';text=oracle.read_text()
+        text=text.replace('self.disabled = frozenset(disabled)',f'self.disabled = frozenset(disabled) | {{{detector!r}}}')
+        oracle.write_text(text)
+        step=case.execute([sys.executable,directory/'qualification.py','--profile-json',config,'--seed',str(seed),'--output',case.path/'result'],timeout=args.timeout)
+        marker='selftest_missing_detection: '+test
+        ok=step['result']!='TIMEOUT' and step['returncode'] not in (0,None) and marker in output(step)
+        case.finish('PASS' if ok else 'FAIL',None if ok else 'Detector removal did not fail its intended self-test',
+                    expected='MODEL_DETECTOR_REMOVAL',detector=detector,selftest=test)
+    for name,old,new,detector in [('credit','self.U += 1','self.U += 2','resource_equations'),
+                                  ('buffer','self.buffered.append(due)','self.buffered.extend([due,due])','buffer_delta')]:
+        case=Case(run,'memory-tx-wrong-model-delta-'+name,seed)
+        directory=case.path/'isolated-model';shutil.copytree(ROOT/'dv/memory_tx',directory,ignore=shutil.ignore_patterns('__pycache__'))
+        oracle=directory/'oracle.py';text=oracle.read_text()
+        if old not in text:case.finish('FAIL','Missing intended model mutation anchor');continue
+        oracle.write_text(text.replace(old,new))
+        step=case.execute([sys.executable,directory/'qualification.py','--profile-json',config,'--seed',str(seed),'--output',case.path/'result'],timeout=args.timeout)
+        import re
+        diagnostics=re.findall(r'oracle\.Violation: ([a-z_]+):',output(step))
+        ok=step['result']!='TIMEOUT' and step['returncode'] not in (0,None) and diagnostics==[detector]
+        case.finish('PASS' if ok else 'FAIL',None if ok else 'Wrong model delta did not hit intended independent self-test',
+                    expected='WRONG_MODEL_DELTA',detector=detector,observed_detectors=diagnostics)
diff --git a/tools/memory_tx_bench.py b/tools/memory_tx_bench.py
new file mode 100644
index 0000000..6d5308e
--- /dev/null
+++ b/tools/memory_tx_bench.py
@@ -0,0 +1,135 @@
+"""Compile and qualify public-action replay with P07 passive UVM monitors."""
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+from evidence import Case, ROOT, IGNORED, completed, output
+from registry import sources, fingerprint, profile
+from memory_tx import parameters
+
+
+def bench(run,args):
+    sys.path.insert(0,str(ROOT/'dv/memory_tx'))
+    from oracle import Profile, Violation, require
+    from qualification import replay
+    from traces import legal_trace, reset_traces, atomic_overlap_trace, Trace
+    from adapter import write_replay, read_observed
+    p=Profile(**parameters(args));seed=(args.seed or [17])[0]
+    run.scope='P07/UVM passive-edge memory/TX replay preparation; no DUT execution'
+    registered=sources('memory-tx-preparation')
+    build=Case(run,'memory-tx-bench-build',seed)
+    build.data.update(parameters=parameters(args),source_set='memory-tx-preparation',
+                      registered_source_digests=fingerprint('memory-tx-preparation'))
+    params=profile(args.profile)
+    params.update(CELL_ID_W=max(1,(p.cells-1).bit_length()),CELL_COUNT_W=p.cells.bit_length(),
+                  DESC_ID_W=max(1,(p.descriptors-1).bit_length()),DESC_COUNT_W=p.descriptors.bit_length(),
+                  DEFICIT_W=(4096+p.max_length-1).bit_length())
+    config=build.path/'tm_bench_config.svh'
+    config.write_text(''.join(f'parameter int {k}={v};\n' for k,v in params.items()))
+    uvm_src=Path(os.environ.get('UVM_HOME',str(ROOT/'.deps/src/uvm')))/'src'
+    binary=build.path/'obj/Vmemory_tx_replay_top'
+    argv=['verilator','--binary','--timing','--assert','--coverage','--trace-vcd',
+          '--timescale','1ns/1ps','+define+UVM_NO_DPI','+define+TM_MEMORY_TX_PREPARATION',
+          '--build-jobs',str(args.jobs),'--output-groups','4','--output-split','20000',
+          '--output-split-cfuncs','500','-CFLAGS','-O0','-I'+str(uvm_src),'-I'+str(build.path)]
+    argv+=['-I'+str(ROOT/path) for path in registered['include_dirs']]
+    argv+=[str(uvm_src/'uvm_pkg.sv')]+[str(ROOT/path) for path in registered['sources']]
+    argv+=['--top-module','memory_tx_replay_top','--Mdir',str(binary.parent)]
+    step=build.execute(argv,timeout=args.build_timeout)
+    status,reason=step['result'],step['first_failure']
+    if IGNORED.search(output(step)):status,reason='UNSUPPORTED','Required SV construct ignored'
+    if status=='PASS' and not binary.is_file():status,reason='TOOL_ERROR','Missing replay executable'
+    build.finish(status,reason)
+    if status!='PASS':return
+    cases=[('legal',legal_trace(p,seed),None,None),('atomic-overlap',atomic_overlap_trace(p,seed),None,None)]
+    cases += [('reset-'+name,trace,None,None) for name,trace in reset_traces(p,seed).items()]
+    baseline=cases[0][1]
+    # These are labeled corrupt electrical/action fixtures, never production RTL.
+    for fault in ('wrong-response','missing-response','wrong-output','missing-done','missing-free','missing-final'):
+        trace=deepcopy(baseline)
+        if fault=='missing-final':
+            end=next(i for i,s in enumerate(trace) if 'done' in s['actions'])
+            trace=trace[:end]
+            detector='shutdown_ownership'
+        else:
+            for i,s in enumerate(trace):
+                a=s['actions']
+                if fault=='wrong-response' and 'response' in a:
+                    a['response']['data']^=1;detector='response_data';break
+                if fault=='missing-response' and 'response' in a:
+                    del a['response'];detector='response_presence';break
+                if fault=='wrong-output' and s['out']['valid'] and s['out']['ready'] and not (trace[i-1]['out']['valid'] and not trace[i-1]['out']['ready']):
+                    s['out']['data']^=1;detector='output_data';break
+                if fault=='missing-done' and 'done' in a:
+                    del a['done'];detector='descriptor_completion_presence';break
+                if fault=='missing-free' and 'free' in a:
+                    del a['free'];detector='cell_completion_presence';break
+        cases.append((fault,trace,None,detector))
+    idle=Trace(p,seed);idle.reset();idle.edge();idle.edge()
+    final_index=next(i for i,s in enumerate(baseline) if 'done' in s['actions'])
+    pending_index=next(i for i,s in enumerate(baseline) if 'read' in s['actions'])
+    cases += [('absent-trigger',idle.samples,'ABSENT_TRIGGER','MEMORY_REQUIRED_TRIGGER'),
+              ('nonempty-end',baseline[:pending_index+1],'NONEMPTY_END','MEMORY_SHUTDOWN'),
+              ('missing-final-sample',baseline[:final_index+1],'OMIT_FINAL_ACTION','MEMORY_SAMPLE_MISSING')]
+    cases += [('collector-'+name,baseline,flag,detector) for name,flag,detector in
+              [('omission','OMIT_ACTION','MEMORY_SAMPLE_MIXED'),
+               ('duplicate','DUPLICATE_SAMPLE','MEMORY_SAMPLE_DUPLICATE'),
+               ('mixed','MIXED_SAMPLE','MEMORY_SAMPLE_MIXED')]]
+    signatures=[]
+    for name,samples,flag,expected in cases:
+        case=Case(run,'memory-tx-bench-'+name,seed)
+        case.data.update(parameters=parameters(args),source_set='memory-tx-preparation',
+                         expected='LABELED_CORRUPT_REPLAY' if expected else 'LEGAL_REPLAY')
+        trace=case.path/'replay.txt';write_replay(trace,samples)
+        case.data['artifacts'].update(stimulus=str(trace),observed=str(case.path/'observed.jsonl'))
+        command=[str(binary),'+UVM_NO_RELNOTES','+REPLAY='+str(trace),f'+verilator+seed+{seed}']
+        if expected:command+=['+TRACE']
+        if flag:command+=['+'+flag]
+        step=case.execute(command,timeout=args.timeout,cwd=case.path)
+        text=output(step)
+        if flag:
+            diagnostics=re.findall(r'UVM_FATAL[^\n]*\[([^]]+)\]',text)
+            ok=step['result']!='TIMEOUT' and step['returncode'] not in (0,None) and diagnostics==[expected]
+            case.finish('PASS' if ok else 'FAIL',None if ok else 'Intended first collector diagnostic absent',detector=expected,observed_diagnostics=diagnostics)
+            continue
+        result,why=completed(step,'TM_MEMORY_TX_BENCH_PASS')
+        intended_sv={'response_data':'MEMORY_RESPONSE_DATA','response_presence':'MEMORY_RESPONSE_PRESENCE',
+                     'shutdown_ownership':'MEMORY_SHUTDOWN'}
+        sv_detection=False
+        assertion_map={'response_presence':'a_response_due','descriptor_completion_presence':'a_done',
+                       'cell_completion_presence':'a_cell_return'}
+        assertion_detection=False
+        if expected in assertion_map:
+            # Only the intended immediate assertion plus a real waveform qualifies.
+            named=re.findall(r'Assertion failed in [^\n:]*\.(a_[a-z_]+)',text)
+            wave=case.path/'wave.vcd'
+            assertion_detection=step['result']!='TIMEOUT' and step['returncode'] not in (0,None) and named==[assertion_map[expected]] and wave.is_file() and wave.stat().st_size>0
+            if assertion_detection:
+                result,why='PASS',None
+                case.data.update(detector=expected,sv_assertion=named[0])
+                case.data['artifacts']['waveform']=str(wave)
+
+        if expected in intended_sv:
+            diagnostics=re.findall(r'UVM_FATAL[^\n]*\[([^]]+)\]',text)
+            sv_detection=step['result']!='TIMEOUT' and step['returncode'] not in (0,None) and diagnostics==[intended_sv[expected]]
+            if sv_detection:result,why='PASS',None
+        if result=='PASS':
+            try:
+                observed=read_observed(case.path/'observed.jsonl')
+                require(observed==(samples[:len(observed)] if sv_detection or assertion_detection else samples),
+                        'bench_transport','missing/changed sampled edge')
+                if expected and not assertion_detection:
+                    try:replay(observed,p,finish=not sv_detection or expected=='shutdown_ownership')
+                    except Violation as error:require(error.detector==expected,'bench_wrong_detector',str(error))
+                    else:raise ValueError('Corrupt replay passed independent checker')
+                    case.data.update(detector=expected,observed_detector=expected,sv_detection=sv_detection)
+                elif not expected:
+                    required=['complete']+(['packet_final_hold'] if name!='atomic-overlap' else ['atomic_store_retire'])
+                    case.data['observed_coverage']=replay(observed,p,required)
+                    signatures.append(hashlib.sha256((case.path/'observed.jsonl').read_bytes()).hexdigest())
+                case.data['sampled_edges']=len(observed)
+            except (OSError,ValueError,AssertionError) as error:result,why='FAIL',str(error)
+        case.finish(result,why)
