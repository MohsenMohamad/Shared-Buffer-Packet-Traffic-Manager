index 0000000..a691ce3
--- /dev/null
+++ b/dv/memory_tx/wires.svh
@@ -0,0 +1,40 @@
+// Transport only; flags are sampled public actions, not expectations.
+typedef struct packed {
+    logic [31:0] reserve_v;
+    logic [31:0] desc;
+    logic [31:0] length;
+    logic [31:0] qid;
+    logic [31:0] tag;
+    logic [31:0] source;
+    logic [31:0] alloc_v;
+    logic [31:0] alloc_cell;
+    logic [31:0] alloc_desc;
+    logic [31:0] write_v;
+    logic [31:0] write_addr;
+    logic [63:0] write_data;
+    logic [31:0] info_v;
+    logic [31:0] info_desc;
+    logic [31:0] info_length;
+    logic [31:0] info_qid;
+    logic [31:0] info_tag;
+    logic [31:0] info_source;
+    logic [31:0] info_head;
+    logic [31:0] link_v;
+    logic [31:0] link_cell;
+    logic [31:0] link_next;
+    logic [31:0] commit_v;
+    logic [31:0] commit_desc;
+    logic [31:0] dispatch_v;
+    logic [31:0] dispatch_desc;
+    logic [31:0] read_v;
+    logic [31:0] read_addr;
+    logic [31:0] response_v;
+    logic [63:0] response_data;
+    logic [31:0] query_v;
+    logic [31:0] query_cell;
+    logic [31:0] query_next;
+    logic [31:0] free_v;
+    logic [31:0] free_cell;
+    logic [31:0] done_v;
+    logic [31:0] done_desc;
+} memory_actions_t;
