// Common parameter list; include inside #(...). No independent defaults.
parameter integer DATA_W=64,
parameter integer N_RX=4,
parameter integer N_Q=16,
parameter integer CELL_BYTES=64,
parameter integer N_CELL=1024,
parameter integer N_DESC=256,
parameter integer MAX_PACKET_BYTES=1536,
parameter integer RX_FIFO_DEPTH=2,
parameter integer MEM_RD_LATENCY=1,
parameter integer TX_FIFO_DEPTH=4,
parameter integer SCHED_MODE=1,
parameter integer QUANTUM_DEFAULT=MAX_PACKET_BYTES,
parameter integer TRACE_ENABLE=1,
parameter integer CELL_ID_W=(N_CELL>1 ? $clog2(N_CELL) : 1),
parameter integer DESC_ID_W=(N_DESC>1 ? $clog2(N_DESC) : 1),
parameter integer CELL_COUNT_W=(N_CELL>0 ? $clog2(N_CELL+1) : 1),
parameter integer DESC_COUNT_W=(N_DESC>0 ? $clog2(N_DESC+1) : 1),
parameter integer DEFICIT_W=$clog2(4096+MAX_PACKET_BYTES)
